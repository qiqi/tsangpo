# =====================================================================
# Himalayan eSTOL - parametric configuration model (Engineering Sketch Pad)
# ---------------------------------------------------------------------
# Scope: wing + outboard flap (with parametric inboard gap) + H-tail.
#   - Fuselage and V-tail are intentionally omitted: not needed for the
#     flap-gap / H-tail interaction study.
#   - The 10 propellers are modeled directly in Flow360 as actuator
#     disks; no disk geometry is built here.
#
# All dimensions in feet, angles in degrees. Origin at the wing root
# quarter-chord on the symmetry plane (Y = 0); +X aft, +Y starboard, +Z up.
# Numbers mirror ../params.py; the two files must be edited together.
# =====================================================================

# ----- Wing planform (Hershey bar - rectangular, untwisted, no sweep) -
despmtr   wing_area_ft2     165.0
despmtr   wing_AR             8.0
despmtr   wing_naca        2412     # 2% camber @ 40%c, 12% t/c
despmtr   tail_naca        0010     # symmetric, 10% t/c

set       wing_span           sqrt(wing_AR*wing_area_ft2)
set       wing_semispan       wing_span/2
set       wing_chord          wing_area_ft2/wing_span
set       MAC                 wing_chord

# ----- Flap / inboard gap ---------------------------------------------
despmtr   flap_chord_frac    0.40
despmtr   flap_outboard_eta  0.95
despmtr   gap_fraction       0.0     # 0.0 = Baseline, 0.35 = Proposed
despmtr   flap_defl_deg     35.0

# ----- H-tail (Hershey bar; Z_tail, X_tail swept by Study 1) ---------
despmtr   htail_span_frac    0.35
despmtr   htail_AR            4.5
despmtr   X_tail_mac          3.5
despmtr   Z_tail_chords       0.0

set       htail_span          htail_span_frac*wing_span
set       htail_semispan      htail_span/2
set       htail_area          htail_span^2/htail_AR
set       htail_chord         htail_area/htail_span
set       X_tail              X_tail_mac*MAC
set       Z_tail              Z_tail_chords*MAC

# =====================================================================
# BUILD
# =====================================================================

# --- Wing right semi-span: constant-chord rule (root section to tip) -
# NACA UDP draws the airfoil in the XY plane (chord on X, thickness on Y).
# `rotatex 90` swings that sketch into the XZ plane so thickness lives in
# Z, which is what every downstream mesher and renderer expects.
mark
   udprim    naca      Series    wing_naca
   rotatex   90   0   0
   scale     wing_chord
   translate -0.25*wing_chord   0   0

   udprim    naca      Series    wing_naca
   rotatex   90   0   0
   scale     wing_chord
   translate -0.25*wing_chord   wing_semispan   0
rule 0
store     wing_right

restore   wing_right
mirror    0  1  0
store     wing_left

# --- Flap (thin box hinged at the wing trailing edge, deflected down) -
# Hinge line is at the wing TE on the chord plane; the box is then
# rotated about that line by -flap_defl_deg so the flap drops below
# the wing. This guarantees no volumetric overlap with the wing.
set       x_flap_LE   0.75*wing_chord
set       cf          flap_chord_frac*wing_chord
set       flap_y_in   gap_fraction*wing_semispan
set       flap_y_out  flap_outboard_eta*wing_semispan

ifthen    gap_fraction LT flap_outboard_eta
   box       x_flap_LE   flap_y_in   -0.05   cf   flap_y_out-flap_y_in   0.10
   # ROTATEY arg order is (angle, zpivot, xpivot) per OpenCSM source.
   # Positive angle rotates +X toward -Z, so the TE drops below the wing.
   rotatey   flap_defl_deg   0   x_flap_LE
   store     flap_right

   restore   flap_right
   mirror    0  1  0
   store     flap_left
endif

# --- H-tail right semi-span (Hershey bar) ---
mark
   udprim    naca      Series    tail_naca
   rotatex   90   0   0
   scale     htail_chord
   translate X_tail-0.25*htail_chord   0   Z_tail

   udprim    naca      Series    tail_naca
   rotatex   90   0   0
   scale     htail_chord
   translate X_tail-0.25*htail_chord   htail_semispan   Z_tail
rule 0
store     htail_right

restore   htail_right
mirror    0  1  0
store     htail_left

# =====================================================================
# DUMP: one STL per body (so the renderer can color them distinctly),
# plus a single combined STEP for downstream meshers. The lifting
# surfaces are disjoint solids - no boolean union here on purpose.
# =====================================================================
restore   wing_right
dump      wing_right.stl
restore   wing_left
dump      wing_left.stl
restore   htail_right
dump      htail_right.stl
restore   htail_left
dump      htail_left.stl
ifthen    gap_fraction LT flap_outboard_eta
   restore   flap_right
   dump      flap_right.stl
   restore   flap_left
   dump      flap_left.stl
endif

restore   wing_right
restore   wing_left
restore   htail_right
restore   htail_left
ifthen    gap_fraction LT flap_outboard_eta
   restore   flap_right
   restore   flap_left
endif
dump      airframe.step  0  -1

end
