# =====================================================================
# Tsangpo eSTOL — GAPPED-FLAP configuration  (GEOMETRY v2)
# ---------------------------------------------------------------------
# Sister file of tsangpo.csm.  Same airframe (CG-origin layout, bigger
# htail at longer arm).  The main wing is ONE continuous spanwise solid;
# only the FLAP+VANE are split into two side panels with a 0.5 %-of-span
# air gap on each side of the wing's no-cove middle region.
#
# Layout in SEMISPAN units (side counted from centerline, s = semispan):
#   MAIN WING (continuous, full span [-s, +s]):
#     y ∈ [-s, -mid_outer_semispan·s]      coved (flap+vane behind)
#     y ∈ [-mid_outer_semispan·s, +mid_outer_semispan·s]
#                                          complete LS(1)-0417 (no cove)
#     y ∈ [+mid_outer_semispan·s, +s]      coved (flap+vane behind)
#   FLAP + VANE (split into two side panels with the 0.5 %-of-span gap):
#     y ∈ [-flap_outboard_eta·s, -gap_fraction·s]     left flap
#     y ∈ [+gap_fraction·s, +flap_outboard_eta·s]     right flap
#   H-TAIL: single full-span solid (unchanged from v2 base).
#
# Air gap (0.5 % of span = 1 % of semispan on EACH side of the middle):
#   width = (gap_fraction − mid_outer_semispan)·s,  e.g. 0.40−0.39 = 0.01·s
# The gap is between the flap's inboard edge (gap_fraction·s) and the
# wing's no-cove boundary (mid_outer_semispan·s).  In that strip the
# main wing IS still coved but there is no flap behind it — that's the
# "0.5 % flap gap" the design requires for flap deployment.
#
# To make ESP `join` work, the main wing is extruded in THREE coved
# pieces sharing exact spanwise interfaces (both pieces' interface
# face is the same COVED cross-section, so JOIN finds a perfect match).
# The three are spanwise-joined into a single coved full-span solid;
# then the middle tail-cap (build_main_wing_tail.udc, identical fillet
# arc as main_wing.udc) is chord-wise JOIN'd to fill the cove only in
# the middle 39 % of span.  See LESSONS.md on "exact match" for joins.
#
# Defaults below produce the 40 %-gapped-flap configuration:
#   gap_fraction        = 0.40   (inboard 40 % of semispan has no flap)
#   mid_outer_semispan  = 0.39   (1 %-of-semispan = 0.5 %-of-span air gap)
#   flap_outboard_eta   = 0.95   (5 % tip aileron region)
#   flap_panel_frac     = 0.55   (= flap_outboard_eta − gap_fraction)
#   wing_side_frac      = 0.61   (= 1 − mid_outer_semispan; per-side coved
#                                  wing panel width in semispan units)
# All gap-derived spans are SEPARATE despmtrs (not computed in `set`)
# because OpenCSM's `set` parser silently mis-evaluates binary `-`/`+`
# between two NAMED variables (LESSONS.md).  Every `set` line below is
# a single multiplication (named*named or constant*named).
#
# All dimensions in METRES, angles in degrees.  +X aft, +Y starboard,
# +Z up.  Wing LE at x = -0.5 c, wing chord plane at z = +0.4 c.
# H-tail LE at x = +3.5 c (= 4 c aft of wing LE).
# =====================================================================

# ----- Phase selector ------------------------------------------------
#   phase = 0 → stowed,  1 → takeoff,  2 → landing
despmtr   phase            0

ifthen    phase EQ 1
   set    flap_dx          0.290
   set    flap_dy          0.040
   set    flap_rot_deg    -40.0
elseif    phase EQ 2
   set    flap_dx          0.320
   set    flap_dy          0.055
   set    flap_rot_deg    -65.0
else
   set    flap_dx          0.000
   set    flap_dy          0.000
   set    flap_rot_deg     0.0
endif

# ----- Wing planform -------------------------------------------------
despmtr   wing_area_m2     15.33
despmtr   wing_AR            8.0

set       wing_span        sqrt(wing_AR*wing_area_m2)
set       wing_semispan    wing_span/2
set       wing_chord       wing_area_m2/wing_span
set       MAC              wing_chord

# ----- Wing position relative to CG (origin) -------------------------
set       wing_x_LE        -0.5*wing_chord
set       wing_z           +0.4*wing_chord

# ----- Vane / aft-flap rigid assembly pivot --------------------------
despmtr   pivot_x          0.550
despmtr   pivot_y         -0.048

# ----- Gapped-flap layout (all SEMISPAN fractions) -------------------
despmtr   gap_fraction         0.40   # inboard flap edge (flap starts here)
despmtr   mid_outer_semispan   0.39   # middle (no-cove) wing region outer edge
despmtr   flap_outboard_eta    1.00   # flap extends to the wing tip
                                       # (was 0.95 = 5 % tip aileron region)
despmtr   flap_panel_frac      0.60   # = flap_outboard_eta − gap_fraction
despmtr   wing_side_frac       0.61   # = 1 − mid_outer_semispan  (per-side coved wing width)

set       flap_y_in        gap_fraction*wing_semispan
set       flap_y_out       flap_outboard_eta*wing_semispan
set       flap_panel       flap_panel_frac*wing_semispan
set       mid_y_outer      mid_outer_semispan*wing_semispan
set       mid_span         mid_outer_semispan*wing_span         # = 2 * mid_y_outer
set       wing_side_span   wing_side_frac*wing_semispan

# ----- H-tail (v2 dims: bigger, longer arm) --------------------------
despmtr   htail_span_frac   0.40
despmtr   htail_chord_frac  1.00
despmtr   htail_LE_chords   3.5         # htail LE absolute x in CG frame
despmtr   htail_z_chords    0.4         # htail z absolute in CG frame

set       htail_span       htail_span_frac*wing_span
set       htail_semispan   htail_span/2
set       htail_chord      htail_chord_frac*wing_chord
set       htail_area       htail_span*htail_chord
set       htail_x_LE       htail_LE_chords*MAC
set       htail_z_root     htail_z_chords*MAC

# =====================================================================
# BUILD
# =====================================================================

# --- Main wing: three CONTIGUOUS coved spanwise pieces -----------------
# All three use main_wing.udc (same coved cross-section), so their
# adjacent spanwise interface faces are IDENTICAL coved airfoil shapes
# — required for ESP join to find an exact match.  After spanwise join
# the result is a SINGLE coved full-span solid (no air gaps in the
# main element).  The middle tail-cap is then chord-wise joined into
# this solid to fill the cove only in the middle 39 % of span.

# Right side panel (coved): y ∈ [+mid_y_outer, +semispan]
udprim    $/airfoils/main_wing
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   mid_y_outer   wing_z
extrude   0   wing_side_span   0
   attribute _name $main_wing_side_right_coved
store     main_wing_side_right

# Left side panel (coved): y ∈ [-semispan, -mid_y_outer]
udprim    $/airfoils/main_wing
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   -wing_semispan   wing_z
extrude   0   wing_side_span   0
   attribute _name $main_wing_side_left_coved
store     main_wing_side_left

# Middle coved panel: y ∈ [-mid_y_outer, +mid_y_outer]
udprim    $/airfoils/main_wing
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   -mid_y_outer   wing_z
extrude   0   mid_span   0
   attribute _name $main_wing_mid_coved
store     main_wing_mid_coved

# Spanwise join: left + middle + right.  Both interfaces (at y = ±mid_y_outer)
# are coved cross-sections present on both adjacent pieces, so JOIN finds
# the exact match.  Result: a single coved full-span main wing solid.
restore   main_wing_side_left
restore   main_wing_mid_coved
join
restore   main_wing_side_right
join
   attribute _name $main_wing_full_coved
store     main_wing_full_coved

# Middle tail-cap: y ∈ [-mid_y_outer, +mid_y_outer].
# build_estol_geometry.build_main_wing_tail() reuses the IDENTICAL
# fillet_corner() output as build_main_wing() so the four cove-cut
# faces (lower edge / fillet arc / upper edge / blunt TE) are
# point-for-point coincident on this tail-cap solid and on the middle
# segment of `main_wing_full_coved`.  ESP join sews them.
udprim    $/airfoils/main_wing_tail
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   -mid_y_outer   wing_z
extrude   0   mid_span   0
   attribute _name $main_wing_mid_tailcap
store     main_wing_mid_tailcap

# Chord-wise join: full-span coved wing + middle tail-cap.
# After this join the wing solid has a COMPLETE LS(1)-0417 cross-section
# in the middle 39 % of span (cove filled by tail-cap) and a COVED
# cross-section in the outer 30.5 %-of-span panels on each side.
restore   main_wing_full_coved
restore   main_wing_mid_tailcap
join
   attribute _name $main_wing
select face
   attribute capsGroup $main_wing
store     main_wing

# --- Vane + aft-flap rigid assembly (split into left/right panels) ---
# 0.5 %-of-span gap between flap inboard edge (gap_fraction·s) and the
# wing's no-cove boundary (mid_outer_semispan·s) on each side — that is
# the physical "flap gap" the design requires; the main wing in that
# strip is still coved but has no flap inside.
udprim    $/airfoils/vane
rotatez   flap_rot_deg   pivot_x   pivot_y
translate flap_dx   flap_dy   0
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   flap_y_in   wing_z
extrude   0   flap_panel   0
   attribute _name $vane_right
select face
   attribute capsGroup $vane_right
store     vane_right

udprim    $/airfoils/vane
rotatez   flap_rot_deg   pivot_x   pivot_y
translate flap_dx   flap_dy   0
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   -flap_y_out   wing_z
extrude   0   flap_panel   0
   attribute _name $vane_left
select face
   attribute capsGroup $vane_left
store     vane_left

udprim    $/airfoils/flap
rotatez   flap_rot_deg   pivot_x   pivot_y
translate flap_dx   flap_dy   0
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   flap_y_in   wing_z
extrude   0   flap_panel   0
   attribute _name $aft_flap_right
select face
   attribute capsGroup $aft_flap_right
store     aft_flap_right

udprim    $/airfoils/flap
rotatez   flap_rot_deg   pivot_x   pivot_y
translate flap_dx   flap_dy   0
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   -flap_y_out   wing_z
extrude   0   flap_panel   0
   attribute _name $aft_flap_left
select face
   attribute capsGroup $aft_flap_left
store     aft_flap_left

# --- H-tail (inverted LS(1)-0417, single full-span solid) ------------
udprim    $/airfoils/tail
rotatex   90  0  0
scale     htail_chord
translate htail_x_LE   -htail_semispan   htail_z_root
extrude   0   htail_span   0
   attribute _name $htail
select face
   attribute capsGroup $htail
store     htail

# =====================================================================
# DUMP
# =====================================================================
restore   main_wing
dump      main_wing.stl
dump      main_wing.step

restore   vane_right
dump      vane_right.stl
dump      vane_right.step
restore   vane_left
dump      vane_left.stl
dump      vane_left.step
restore   aft_flap_right
dump      aft_flap_right.stl
dump      aft_flap_right.step
restore   aft_flap_left
dump      aft_flap_left.stl
dump      aft_flap_left.step

restore   htail
dump      htail.stl
dump      htail.step

end
