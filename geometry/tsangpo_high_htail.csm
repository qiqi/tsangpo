# =====================================================================
# Tsangpo eSTOL — parametric configuration model  (GEOMETRY v2)
# ---------------------------------------------------------------------
# 3-element high-lift wing:
#   * Main wing — coved LS(1)-0417 (Selig contour with cove cutout +
#     filleted vertex, ~0.5 % c blunt upper-lip face).
#   * Vane     — NACA 9621, anchored between stowed LE/TE.
#   * Aft flap — NACA 6311, anchored between stowed LE/TE.
#   Each closed planar contour lives in airfoils/{main_wing,vane,flap,
#   tail}.udc, generated by airfoils/build_estol_geometry.py from
#   airfoils/estol_config.yaml.
#
# Fowler kinematics: the vane + aft-flap move as a rigid assembly.
# Rotation about pivot_point, then translation by (dx, dy), both in
# stowed-chord-normalized units, applied BEFORE chord scaling so the
# normalized vector scales to physical metres via `scale wing_chord`.
#
# H-tail: inverted LS(1)-0417 (tail.udc). Negative camber gives down-
# force at AoA = 0 without baking in incidence here.  In v2 the htail
# has chord = wing chord and span = 0.40 b_wing — bigger, longer arm.
#
# All dimensions in METRES, angles in degrees.
#
# GEOMETRY VERSION 2 — Origin is the CG.  CG sits under the wing's
# HALF-chord, 0.4 c below the wing chord plane.  +X aft, +Y starboard,
# +Z up.  Wing LE is at x = -0.5 c, wing chord plane at z = +0.4 c.
# H-tail LE is 4.0 c aft of the wing LE, raised 1.5 c above the wing chord plane, with chord = wing chord.
# =====================================================================

# ----- Phase selector ------------------------------------------------
#   phase = 0 → stowed,  1 → takeoff,  2 → landing
despmtr   phase            0

ifthen    phase EQ 1
   set    flap_dx          0.290
   set    flap_dy          0.040
   set    flap_rot_deg    -40.0
elseif    phase EQ 2
   set    flap_dx          0.320
   set    flap_dy          0.055
   set    flap_rot_deg    -65.0
else
   set    flap_dx          0.000
   set    flap_dy          0.000
   set    flap_rot_deg     0.0
endif

# ----- Wing planform -------------------------------------------------
despmtr   wing_area_m2     15.33
despmtr   wing_AR            8.0

set       wing_span        sqrt(wing_AR*wing_area_m2)
set       wing_semispan    wing_span/2
set       wing_chord       wing_area_m2/wing_span      # stowed-chord ref
set       MAC              wing_chord

# ----- Wing position relative to CG (origin) -------------------------
# CG under wing's half-chord and 0.4 c below the wing chord plane.
set       wing_x_LE        -0.5*wing_chord             # wing LE forward of CG
set       wing_z           +0.4*wing_chord             # wing chord plane above CG

# ----- Vane / aft-flap rigid assembly pivot --------------------------
despmtr   pivot_x          0.550
despmtr   pivot_y         -0.048

# ----- Inboard gap (applied to the vane + aft-flap assembly) ---------
despmtr   gap_fraction      0.0      # 0.0 = baseline, 0.35 = proposed
despmtr   flap_outboard_eta 0.95

set       flap_y_in        gap_fraction*wing_semispan
set       flap_y_out       flap_outboard_eta*wing_semispan
set       flap_panel       flap_y_out-flap_y_in

# ----- H-tail (v2: bigger, longer arm) -------------------------------
despmtr   htail_span_frac   0.40        # was 0.35
despmtr   htail_chord_frac  1.00        # c_htail = c_wing  (was ~0.62)
# Htail LE position is expressed as ABSOLUTE chord-fractional offsets
# from the CG (origin), NOT as "wing-LE plus a delta".  An earlier
# version of this file expressed it as `wing_x_LE + X_tail_LE_chords*MAC`,
# but OpenCSM's `set` expression parser silently mis-evaluates binary
# `+` between two named variables — the wing-frame expression
# collapsed to `wing_x_LE` (= -0.692 m) and the htail body ended up
# meshed ON TOP OF the wing.  See flow360/LESSONS.md.  Using absolute
# chord positions sidesteps the parser issue (only `*` remains).
# 3.5 = -0.5 (wing LE relative to CG) + 4.0 (htail LE aft of wing LE).
# 0.4 = wing z relative to CG (low htail in wing plane); +2.5 for high.
despmtr   htail_LE_chords   3.5         # htail LE absolute x in CG frame
despmtr   htail_z_chords    1.9         # htail z absolute in CG frame

set       htail_span       htail_span_frac*wing_span
set       htail_semispan   htail_span/2
set       htail_chord      htail_chord_frac*wing_chord
set       htail_area       htail_span*htail_chord
set       htail_x_LE       htail_LE_chords*MAC
set       htail_z_root     htail_z_chords*MAC

# =====================================================================
# BUILD — each lifting element is built from a closed planar sketch
# (UDC file) in the XY plane, swung into the XZ plane by `rotatex 90`,
# scaled to chord, translated to its root Y-station and z-station,
# then extruded along +Y for the spanwise length.
# =====================================================================

# --- Main wing (full-span solid; cove is upstream of the gap study) --
udprim    $/airfoils/main_wing
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   -wing_semispan   wing_z
extrude   0   wing_span   0
   attribute _name $main_wing
select face
   attribute capsGroup $main_wing
store     main_wing

# --- Vane + aft-flap rigid assembly ----------------------------------
# Kinematics (rotatez about pivot, then translate dx/dy) execute in the
# normalized XY plane BEFORE chord scaling. gap_fraction = 0 builds a
# single full-span pair; 0 < gap_fraction < flap_outboard_eta splits
# into left/right panels.

ifthen    gap_fraction LE 0
   udprim    $/airfoils/vane
   rotatez   flap_rot_deg   pivot_x   pivot_y
   translate flap_dx   flap_dy   0
   rotatex   90  0  0
   scale     wing_chord
   translate wing_x_LE   -wing_semispan   wing_z
   extrude   0   wing_span   0
      attribute _name $vane
   select face
      attribute capsGroup $vane
   store     vane

   udprim    $/airfoils/flap
   rotatez   flap_rot_deg   pivot_x   pivot_y
   translate flap_dx   flap_dy   0
   rotatex   90  0  0
   scale     wing_chord
   translate wing_x_LE   -wing_semispan   wing_z
   extrude   0   wing_span   0
      attribute _name $aft_flap
   select face
      attribute capsGroup $aft_flap
   store     aft_flap
elseif    gap_fraction LT flap_outboard_eta
   udprim    $/airfoils/vane
   rotatez   flap_rot_deg   pivot_x   pivot_y
   translate flap_dx   flap_dy   0
   rotatex   90  0  0
   scale     wing_chord
   translate wing_x_LE   flap_y_in   wing_z
   extrude   0   flap_panel   0
      attribute _name $vane_right
   select face
      attribute capsGroup $vane_right
   store     vane_right

   udprim    $/airfoils/vane
   rotatez   flap_rot_deg   pivot_x   pivot_y
   translate flap_dx   flap_dy   0
   rotatex   90  0  0
   scale     wing_chord
   translate wing_x_LE   -flap_y_out   wing_z
   extrude   0   flap_panel   0
      attribute _name $vane_left
   select face
      attribute capsGroup $vane_left
   store     vane_left

   udprim    $/airfoils/flap
   rotatez   flap_rot_deg   pivot_x   pivot_y
   translate flap_dx   flap_dy   0
   rotatex   90  0  0
   scale     wing_chord
   translate wing_x_LE   flap_y_in   wing_z
   extrude   0   flap_panel   0
      attribute _name $aft_flap_right
   select face
      attribute capsGroup $aft_flap_right
   store     aft_flap_right

   udprim    $/airfoils/flap
   rotatez   flap_rot_deg   pivot_x   pivot_y
   translate flap_dx   flap_dy   0
   rotatex   90  0  0
   scale     wing_chord
   translate wing_x_LE   -flap_y_out   wing_z
   extrude   0   flap_panel   0
      attribute _name $aft_flap_left
   select face
      attribute capsGroup $aft_flap_left
   store     aft_flap_left
endif

# --- H-tail (inverted LS(1)-0417, single full-span solid) ------------
# v2: c_htail = c_wing, span = 0.40 b_wing, LE 4 c_wing aft of wing LE.
udprim    $/airfoils/tail
rotatex   90  0  0
scale     htail_chord
translate htail_x_LE   -htail_semispan   htail_z_root
extrude   0   htail_span   0
   attribute _name $htail
select face
   attribute capsGroup $htail
store     htail

# =====================================================================
# DUMP: one STL + one STEP per body. submit_*.py scripts inline the
# UDC contours into a single .csm and upload that.
# =====================================================================
restore   main_wing
dump      main_wing.stl
dump      main_wing.step

ifthen    gap_fraction LE 0
   restore   vane
   dump      vane.stl
   dump      vane.step
   restore   aft_flap
   dump      aft_flap.stl
   dump      aft_flap.step
elseif    gap_fraction LT flap_outboard_eta
   restore   vane_right
   dump      vane_right.stl
   dump      vane_right.step
   restore   vane_left
   dump      vane_left.stl
   dump      vane_left.step
   restore   aft_flap_right
   dump      aft_flap_right.stl
   dump      aft_flap_right.step
   restore   aft_flap_left
   dump      aft_flap_left.stl
   dump      aft_flap_left.step
endif

restore   htail
dump      htail.stl
dump      htail.step

end
