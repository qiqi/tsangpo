# =====================================================================
# Tsangpo eSTOL — GAPPED-FLAP configuration  (GEOMETRY v2)
# ---------------------------------------------------------------------
# Sister file of tsangpo.csm.  Same airframe (CG-origin layout, bigger
# htail at longer arm), but the inboard portion of the main wing is
# split into TWO physical pieces and the middle one is a complete
# LS(1)-0417 airfoil (no cove) — because there is no flap behind it
# to slot into the cove.
#
# Layout (in SEMISPAN units, side counted from centerline):
#   * Outer wing panels  : coved LS(1)-0417  (vane+aft_flap behind)
#                          y ∈ [gap_fraction·s,  +s]  (right; mirror on left)
#   * Air gap            : width = (gap_fraction − mid_outer_semispan)·s
#                          on each side of the middle wing
#   * Middle wing piece  : complete LS(1)-0417, NO cove, NO flap behind.
#                          (main_wing.udc) JOIN (main_wing_tail.udc).
#                          y ∈ [−mid_outer_semispan·s, +mid_outer_semispan·s]
#   * H-tail             : single full-span solid (unchanged from v2 base).
#
# Defaults below produce the 40 %-gapped-flap configuration:
#   gap_fraction        = 0.40  (inboard 40 % of semispan has no flap)
#   mid_outer_semispan  = 0.39  (1 %-of-semispan = 0.5 %-of-span air-gap
#                                on each side of the middle wing)
#   flap_outboard_eta   = 0.95  (5 % tip aileron region)
#   flap_panel_frac     = 0.55  (= 0.95 − 0.40, flap panel width)
#   side_span_frac      = 0.60  (= 1 − 0.40, outer wing panel width)
#
# All gap-derived spans are accepted as SEPARATE despmtrs (not computed
# in `set` expressions), because OpenCSM's `set` parser silently
# mis-evaluates binary `-`/`+` between two NAMED variables (LESSONS.md).
# The submit script (flow360/submit_gapped_flap.py) must keep them
# consistent.  Every `set` line below is a single multiplication
# (named*named or constant*named).
#
# All dimensions in METRES, angles in degrees.  +X aft, +Y starboard,
# +Z up.  Wing LE at x = -0.5 c, wing chord plane at z = +0.4 c.
# H-tail LE at x = +3.5 c (= 4 c aft of wing LE).
# =====================================================================

# ----- Phase selector ------------------------------------------------
#   phase = 0 → stowed,  1 → takeoff,  2 → landing
despmtr   phase            0

ifthen    phase EQ 1
   set    flap_dx          0.290
   set    flap_dy          0.040
   set    flap_rot_deg    -40.0
elseif    phase EQ 2
   set    flap_dx          0.320
   set    flap_dy          0.055
   set    flap_rot_deg    -65.0
else
   set    flap_dx          0.000
   set    flap_dy          0.000
   set    flap_rot_deg     0.0
endif

# ----- Wing planform -------------------------------------------------
despmtr   wing_area_m2     15.33
despmtr   wing_AR            8.0

set       wing_span        sqrt(wing_AR*wing_area_m2)
set       wing_semispan    wing_span/2
set       wing_chord       wing_area_m2/wing_span
set       MAC              wing_chord

# ----- Wing position relative to CG (origin) -------------------------
set       wing_x_LE        -0.5*wing_chord
set       wing_z           +0.4*wing_chord

# ----- Vane / aft-flap rigid assembly pivot --------------------------
despmtr   pivot_x          0.550
despmtr   pivot_y         -0.048

# ----- Gapped-flap layout (all SEMISPAN fractions) -------------------
despmtr   gap_fraction         0.40   # inboard flap edge (also: outer wing panel inner edge)
despmtr   mid_outer_semispan   0.39   # middle wing outer edge (= gap_fraction - air-gap)
despmtr   flap_outboard_eta    0.95   # outer flap edge (tip ailerons start)
despmtr   flap_panel_frac      0.55   # = flap_outboard_eta - gap_fraction
despmtr   side_span_frac       0.60   # = 1 - gap_fraction

set       flap_y_in        gap_fraction*wing_semispan
set       flap_y_out       flap_outboard_eta*wing_semispan
set       flap_panel       flap_panel_frac*wing_semispan
set       mid_y_outer      mid_outer_semispan*wing_semispan
set       mid_span         mid_outer_semispan*wing_span         # = 2 * mid_y_outer
set       side_y_inner     gap_fraction*wing_semispan
set       side_span        side_span_frac*wing_semispan

# ----- H-tail (v2 dims: bigger, longer arm) --------------------------
despmtr   htail_span_frac   0.40
despmtr   htail_chord_frac  1.00
despmtr   htail_LE_chords   3.5         # htail LE absolute x in CG frame
despmtr   htail_z_chords    0.4         # htail z absolute in CG frame

set       htail_span       htail_span_frac*wing_span
set       htail_semispan   htail_span/2
set       htail_chord      htail_chord_frac*wing_chord
set       htail_area       htail_span*htail_chord
set       htail_x_LE       htail_LE_chords*MAC
set       htail_z_root     htail_z_chords*MAC

# =====================================================================
# BUILD
# =====================================================================

# --- Main wing: three pieces (left side / middle joined / right side) ---
# Right side panel (coved): inboard at +side_y_inner, outboard at +semispan
udprim    $/airfoils/main_wing
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   side_y_inner   wing_z
extrude   0   side_span   0
   attribute _name $main_wing_right
select face
   attribute capsGroup $main_wing_right
store     main_wing_right

# Left side panel (coved): inboard at -side_y_inner, outboard at -semispan
udprim    $/airfoils/main_wing
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   -wing_semispan   wing_z
extrude   0   side_span   0
   attribute _name $main_wing_left
select face
   attribute capsGroup $main_wing_left
store     main_wing_left

# Middle wing: two extrudes sharing the SAME 4 cove-cut faces (lower
# edge, fillet arc, upper edge, blunt edge).  After JOIN the cove
# disappears and the resulting solid has a complete LS(1)-0417 cross-
# section.  build_estol_geometry.build_main_wing_tail() re-uses the
# IDENTICAL fillet_corner() output as build_main_wing() so the two
# splines / linsegs are point-for-point coincident — a hard requirement
# for ESP join to find matching faces.
udprim    $/airfoils/main_wing
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   -mid_y_outer   wing_z
extrude   0   mid_span   0
   attribute _name $main_wing_mid_coved
select face
   attribute capsGroup $main_wing_mid
store     main_wing_mid_a

udprim    $/airfoils/main_wing_tail
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   -mid_y_outer   wing_z
extrude   0   mid_span   0
   attribute _name $main_wing_mid_tailcap
select face
   attribute capsGroup $main_wing_mid
store     main_wing_mid_b

restore   main_wing_mid_a
restore   main_wing_mid_b
join
   attribute _name $main_wing_mid
store     main_wing_mid

# --- Vane + aft-flap rigid assembly (split into left/right panels) ---
udprim    $/airfoils/vane
rotatez   flap_rot_deg   pivot_x   pivot_y
translate flap_dx   flap_dy   0
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   flap_y_in   wing_z
extrude   0   flap_panel   0
   attribute _name $vane_right
select face
   attribute capsGroup $vane_right
store     vane_right

udprim    $/airfoils/vane
rotatez   flap_rot_deg   pivot_x   pivot_y
translate flap_dx   flap_dy   0
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   -flap_y_out   wing_z
extrude   0   flap_panel   0
   attribute _name $vane_left
select face
   attribute capsGroup $vane_left
store     vane_left

udprim    $/airfoils/flap
rotatez   flap_rot_deg   pivot_x   pivot_y
translate flap_dx   flap_dy   0
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   flap_y_in   wing_z
extrude   0   flap_panel   0
   attribute _name $aft_flap_right
select face
   attribute capsGroup $aft_flap_right
store     aft_flap_right

udprim    $/airfoils/flap
rotatez   flap_rot_deg   pivot_x   pivot_y
translate flap_dx   flap_dy   0
rotatex   90  0  0
scale     wing_chord
translate wing_x_LE   -flap_y_out   wing_z
extrude   0   flap_panel   0
   attribute _name $aft_flap_left
select face
   attribute capsGroup $aft_flap_left
store     aft_flap_left

# --- H-tail (inverted LS(1)-0417, single full-span solid) ------------
udprim    $/airfoils/tail
rotatex   90  0  0
scale     htail_chord
translate htail_x_LE   -htail_semispan   htail_z_root
extrude   0   htail_span   0
   attribute _name $htail
select face
   attribute capsGroup $htail
store     htail

# =====================================================================
# DUMP
# =====================================================================
restore   main_wing_right
dump      main_wing_right.stl
dump      main_wing_right.step
restore   main_wing_left
dump      main_wing_left.stl
dump      main_wing_left.step
restore   main_wing_mid
dump      main_wing_mid.stl
dump      main_wing_mid.step

restore   vane_right
dump      vane_right.stl
dump      vane_right.step
restore   vane_left
dump      vane_left.stl
dump      vane_left.step
restore   aft_flap_right
dump      aft_flap_right.stl
dump      aft_flap_right.step
restore   aft_flap_left
dump      aft_flap_left.stl
dump      aft_flap_left.step

restore   htail
dump      htail.stl
dump      htail.step

end
