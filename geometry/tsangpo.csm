# =====================================================================
# Tsangpo eSTOL — parametric configuration model
# ---------------------------------------------------------------------
# 3-element high-lift wing:
#   * Main wing — coved LS(1)-0417 (Selig contour with cove cutout +
#     filleted vertex, ~0.5 % c blunt upper-lip face).
#   * Vane     — NACA 9621, anchored between stowed LE/TE.
#   * Aft flap — NACA 6311, anchored between stowed LE/TE.
#   Each closed planar contour lives in airfoils/{main_wing,vane,flap,
#   tail}.udc, generated by airfoils/build_estol_geometry.py from
#   airfoils/estol_config.yaml.
#
# Fowler kinematics: the vane + aft-flap move as a rigid assembly.
# Rotation about pivot_point, then translation by (dx, dy), both in
# stowed-chord-normalized units, applied BEFORE chord scaling so the
# normalized vector scales to physical feet via `scale wing_chord`.
#
# H-tail: inverted LS(1)-0417 (tail.udc). Negative camber gives down-
# force at AoA = 0 without baking in incidence here.
#
# All dimensions in METRES, angles in degrees. Origin at the wing root
# quarter-chord (of the stowed 3-element chord) on the symmetry plane
# (Y = 0); +X aft, +Y starboard, +Z up.
# =====================================================================

# ----- Phase selector ------------------------------------------------
#   phase = 0 → stowed,  1 → takeoff,  2 → landing
# Values match airfoils/estol_config.yaml :: kinematics.phases.
despmtr   phase            0

ifthen    phase EQ 1
   set    flap_dx          0.290
   set    flap_dy          0.040
   set    flap_rot_deg    -40.0
elseif    phase EQ 2
   set    flap_dx          0.320
   set    flap_dy          0.055
   set    flap_rot_deg    -65.0
else
   set    flap_dx          0.000
   set    flap_dy          0.000
   set    flap_rot_deg     0.0
endif

# ----- Wing planform -------------------------------------------------
despmtr   wing_area_m2     15.33
despmtr   wing_AR            8.0

set       wing_span        sqrt(wing_AR*wing_area_m2)
set       wing_semispan    wing_span/2
set       wing_chord       wing_area_m2/wing_span   # stowed-chord ref
set       MAC              wing_chord

# ----- Vane / aft-flap rigid assembly pivot --------------------------
despmtr   pivot_x          0.550
despmtr   pivot_y         -0.048

# ----- Inboard gap (applied to the vane + aft-flap assembly) ---------
despmtr   gap_fraction      0.0     # 0.0 = baseline, 0.35 = proposed
despmtr   flap_outboard_eta 0.95

set       flap_y_in        gap_fraction*wing_semispan
set       flap_y_out       flap_outboard_eta*wing_semispan
set       flap_panel       flap_y_out-flap_y_in

# ----- H-tail --------------------------------------------------------
despmtr   htail_span_frac   0.35
despmtr   htail_AR          4.5
despmtr   X_tail_mac        3.5
despmtr   Z_tail_chords     0.0

set       htail_span       htail_span_frac*wing_span
set       htail_semispan   htail_span/2
set       htail_area       htail_span^2/htail_AR
set       htail_chord      htail_area/htail_span
set       X_tail           X_tail_mac*MAC
set       Z_tail           Z_tail_chords*MAC

# =====================================================================
# BUILD — each lifting element is built from a closed planar sketch
# (UDC file) in the XY plane, swung into the XZ plane by `rotatex 90`,
# scaled to chord, translated to its root Y-station, then extruded
# along +Y for the spanwise length.
# =====================================================================

# --- Main wing (full-span solid; cove is upstream of the gap study) --
udprim    $/airfoils/main_wing
rotatex   90  0  0
scale     wing_chord
translate -0.25*wing_chord   -wing_semispan   0
extrude   0   wing_span   0
   attribute _name $main_wing
select face
   attribute capsGroup $main_wing
store     main_wing

# --- Vane + aft-flap rigid assembly ----------------------------------
# Kinematics (rotatez about pivot, then translate dx/dy) execute in the
# normalized XY plane BEFORE chord scaling. gap_fraction = 0 builds a
# single full-span pair; 0 < gap_fraction < flap_outboard_eta splits
# into left/right panels.

ifthen    gap_fraction LE 0
   udprim    $/airfoils/vane
   rotatez   flap_rot_deg   pivot_x   pivot_y
   translate flap_dx   flap_dy   0
   rotatex   90  0  0
   scale     wing_chord
   translate -0.25*wing_chord   -wing_semispan   0
   extrude   0   wing_span   0
      attribute _name $vane
   select face
      attribute capsGroup $vane
   store     vane

   udprim    $/airfoils/flap
   rotatez   flap_rot_deg   pivot_x   pivot_y
   translate flap_dx   flap_dy   0
   rotatex   90  0  0
   scale     wing_chord
   translate -0.25*wing_chord   -wing_semispan   0
   extrude   0   wing_span   0
      attribute _name $aft_flap
   select face
      attribute capsGroup $aft_flap
   store     aft_flap
elseif    gap_fraction LT flap_outboard_eta
   udprim    $/airfoils/vane
   rotatez   flap_rot_deg   pivot_x   pivot_y
   translate flap_dx   flap_dy   0
   rotatex   90  0  0
   scale     wing_chord
   translate -0.25*wing_chord   flap_y_in   0
   extrude   0   flap_panel   0
      attribute _name $vane_right
   select face
      attribute capsGroup $vane_right
   store     vane_right

   udprim    $/airfoils/vane
   rotatez   flap_rot_deg   pivot_x   pivot_y
   translate flap_dx   flap_dy   0
   rotatex   90  0  0
   scale     wing_chord
   translate -0.25*wing_chord   -flap_y_out   0
   extrude   0   flap_panel   0
      attribute _name $vane_left
   select face
      attribute capsGroup $vane_left
   store     vane_left

   udprim    $/airfoils/flap
   rotatez   flap_rot_deg   pivot_x   pivot_y
   translate flap_dx   flap_dy   0
   rotatex   90  0  0
   scale     wing_chord
   translate -0.25*wing_chord   flap_y_in   0
   extrude   0   flap_panel   0
      attribute _name $aft_flap_right
   select face
      attribute capsGroup $aft_flap_right
   store     aft_flap_right

   udprim    $/airfoils/flap
   rotatez   flap_rot_deg   pivot_x   pivot_y
   translate flap_dx   flap_dy   0
   rotatex   90  0  0
   scale     wing_chord
   translate -0.25*wing_chord   -flap_y_out   0
   extrude   0   flap_panel   0
      attribute _name $aft_flap_left
   select face
      attribute capsGroup $aft_flap_left
   store     aft_flap_left
endif

# --- H-tail (inverted LS(1)-0417, single full-span solid) ------------
udprim    $/airfoils/tail
rotatex   90  0  0
scale     htail_chord
translate X_tail-0.25*htail_chord   -htail_semispan   Z_tail
extrude   0   htail_span   0
   attribute _name $htail
select face
   attribute capsGroup $htail
store     htail

# =====================================================================
# DUMP: one STL + one STEP per body (no combined airframe.step — Flow360
# rejects multi-file STEP uploads anyway; submit_cruise.py inlines this
# CSM and uploads it as a single .csm instead).
# =====================================================================
# Per-body dumps. Body0000N order on the Flow360 side is irrelevant —
# surface names come from `attribute capsGroup $<name>` on each face
# (set in the build section above), and submit_cruise.py groups faces
# by `capsGroup`.
restore   main_wing
dump      main_wing.stl
dump      main_wing.step

ifthen    gap_fraction LE 0
   restore   vane
   dump      vane.stl
   dump      vane.step
   restore   aft_flap
   dump      aft_flap.stl
   dump      aft_flap.step
elseif    gap_fraction LT flap_outboard_eta
   restore   vane_right
   dump      vane_right.stl
   dump      vane_right.step
   restore   vane_left
   dump      vane_left.stl
   dump      vane_left.step
   restore   aft_flap_right
   dump      aft_flap_right.stl
   dump      aft_flap_right.step
   restore   aft_flap_left
   dump      aft_flap_left.stl
   dump      aft_flap_left.step
endif

restore   htail
dump      htail.stl
dump      htail.step

end
